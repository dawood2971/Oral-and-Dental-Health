{
  "name": "ibtisamati-motion",
  "private": true,
  "description": "Motion layer for the interactive page: Lenis smooth scroll on the GSAP ticker, plus React Bits effects.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../../assets/motion.js && cp node_modules/lenis/dist/lenis.css ../../assets/lenis.css"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
